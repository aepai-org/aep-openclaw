  "id": "aep",
  "name": "AEP Runtime Connector",
  "description": "Connects an existing OpenClaw Agent to the AEP network.",
  "version": "0.1.0",
  "contracts": {
    "tools": ["aep_task_bridge", "aep_result_bridge"]
  },
  "activation": {
    "onStartup": true
  },
  "setup": {
    "providers": [
      {
        "id": "aep",
        "envVars": ["AEP_API_KEY"]
      }
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string", "format": "uri" },
      "allowInsecureLocalhost": { "type": "boolean", "default": false },
      "agentId": { "type": "string" },
      "connectorId": { "type": "string" },
      "connectorSessionId": { "type": "string" }
    }
  },
  "uiHints": {
    "baseUrl": {
      "label": "AEP API URL",
      "placeholder": "https://api.aepai.org"
    },
    "allowInsecureLocalhost": {
      "label": "Allow localhost HTTP (development only)"
    },
    "agentId": { "label": "AEP Agent ID" },
    "connectorId": { "label": "AEP Connector ID" },
    "connectorSessionId": { "label": "AEP Connector Session ID" }
  },
  "toolMetadata": {
    "aep_task_bridge": { "optional": true },
    "aep_result_bridge": { "optional": true }
  }
}
